# Runs station_signal_api unattended and restarts it on crash/reboot.
#
# Privilege model: run_dev.sh runs the API (and the daemon it spawns as a child) under sudo,
# because the daemon needs CAP_NET_RAW for raw GOOSE reception. For an always-on service,
# running perpetually as root is more exposure than necessary — this unit instead runs as an
# unprivileged service user and expects the *daemon binary* to carry the capability directly:
#
#   sudo setcap cap_net_raw+ep /opt/station_signal/bin/station_signal_daemon
#
# This resolves the "privilege model for spawning the daemon" open question noted in
# station_signal_api/CLAUDE.md — confirm this is the intended approach before relying on it.
#
# Install as /etc/systemd/system/station-signal-api.service, create the station-signal service
# user, deploy the built binaries to the paths below (or edit the paths to match), then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now station-signal-api

[Unit]
Description=station_signal_api (supervises station_signal_daemon, serves the frontend-facing API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=station-signal
Group=station-signal
Environment=STATION_SIGNAL_DAEMON_BIN=/opt/station_signal/bin/station_signal_daemon
Environment=STATION_SIGNAL_API_HTTP_ADDR=:8080
Environment=STATION_SIGNAL_API_LOG_LEVEL=info
Environment=STATION_SIGNAL_API_STRUCTURE_FILE_DIR=/opt/station_signal/structure_files
# Settings-page remote static-IP reconfiguration (internal/features/network) — the one place
# this otherwise-unprivileged process reaches root, via sudo + the sudoers rule in
# deploy/sudoers/station-signal-netconfig gating this exact script.
Environment=STATION_SIGNAL_API_NETCONFIG_HELPER=/opt/station_signal/bin/station-signal-netconfig.sh
Environment=STATION_SIGNAL_API_NETCONFIG_REVERT_TIMEOUT_SECONDS=90
ExecStart=/opt/station_signal/bin/station_signal_api
Restart=on-failure
RestartSec=2s
# Plain append-mode log file, not just the journal — this box is often on-site talking to an IED
# over its one Ethernet port with no route back for `journalctl -u ... -f` to be watched live, so
# a technician needs to be able to walk up after the fact and read a file directly. The directory
# is created/chowned explicitly by deploy/setup.sh, NOT via LogsDirectory= — that directive failed
# to materialize the directory before this unit's own StandardOutput/StandardError open() on at
# least one real deployment (systemd version/config not yet root-caused), taking the whole service
# down in a restart loop; a plain mkdir in setup.sh has no such failure mode. Both streams append
# here since the daemon's own stderr is inherited straight through by this process (see
# station_signal_api/internal/features/supervision/data/process.go) — daemon and API log lines
# interleave in one file, same as they already do in the journal today.
StandardOutput=append:/var/log/station_signal/station-signal-api.log
StandardError=append:/var/log/station_signal/station-signal-api.log

[Install]
WantedBy=multi-user.target
