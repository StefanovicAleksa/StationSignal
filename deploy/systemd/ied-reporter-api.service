# Runs ied_reporter_api unattended and restarts it on crash/reboot.
#
# Privilege model: run_dev.sh runs the API (and the daemon it spawns as a child) under sudo,
# because the daemon needs CAP_NET_RAW for raw GOOSE reception. For an always-on service,
# running perpetually as root is more exposure than necessary — this unit instead runs as an
# unprivileged service user and expects the *daemon binary* to carry the capability directly:
#
#   sudo setcap cap_net_raw+ep /opt/ied_reporter/bin/ied_reporter_daemon
#
# This resolves the "privilege model for spawning the daemon" open question noted in
# ied_reporter_api/CLAUDE.md — confirm this is the intended approach before relying on it.
#
# Install as /etc/systemd/system/ied-reporter-api.service, create the ied-reporter service
# user, deploy the built binaries to the paths below (or edit the paths to match), then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ied-reporter-api

[Unit]
Description=ied_reporter_api (supervises ied_reporter_daemon, serves the frontend-facing API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ied-reporter
Group=ied-reporter
Environment=IED_REPORTER_DAEMON_BIN=/opt/ied_reporter/bin/ied_reporter_daemon
Environment=IED_REPORTER_API_HTTP_ADDR=:8080
Environment=IED_REPORTER_API_LOG_LEVEL=info
Environment=IED_REPORTER_API_STRUCTURE_FILE_DIR=/opt/ied_reporter/structure_files
ExecStart=/opt/ied_reporter/bin/ied_reporter_api
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
