# Runtime debug artifact written by the daemon this API supervises - not source, not
# reproducible/meaningful across machines, sometimes root-owned since it's produced by a
# sudo-run process.
ied_reporter_debug_entryid.log

# Built binaries (run_dev.sh/deploy/setup.sh build these to /tmp or /opt, never in-repo)
/ied_reporter_api

# Editor
.vscode/*
!.vscode/extensions.json

# Local/personal Claude Code config - not shared project config (same convention as
# ied_reporter_daemon/.gitignore)
.claude/settings.local.json
