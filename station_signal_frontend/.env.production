# Must be explicitly blank, not omitted: Vite merges .env.production with the base .env rather
# than replacing it, so leaving this key out entirely lets dev's VITE_API_BASE_URL
# (http://localhost:8080) leak into the production build. An empty value here overrides that,
# and apiClient.ts's `||` fallback treats "" the same as unset, using window.location.origin
# instead — so the built app calls the API on whatever host/IP nginx answered the page on (see
# ../deploy/nginx/stationsignal.conf), rather than a hardcoded host.
VITE_API_BASE_URL=

# Same merge semantics as above: .env sets this to dev, so a production build has to override it
# explicitly. deploy/setup.sh passes VITE_STATION_SIGNAL_MODE=dev inline when installing in dev
# mode, which beats both files.
VITE_STATION_SIGNAL_MODE=prod
