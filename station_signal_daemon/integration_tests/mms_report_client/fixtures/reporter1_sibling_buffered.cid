<?xml version="1.0" encoding="UTF-8"?>
<SCL xmlns="http://www.iec.ch/61850/2003/SCL">
  <Header id="reporter1-sibling-buffered-fixture" nameStructure="IEDName" />

  <!-- Variant of reporter1.cid declaring a SECOND buffered Dyn RCB (brcbDyn2)
       alongside brcbDyn, both parented under GGIO1 - for
       test_siblingBufferedDynRcbs_reconnectDoesNotCrossAdoptEachOthersLeftoverDataset's
       own coverage of adoptUnclaimedDataset's preferred-own-name pass
       (mms_report_client_connection.c): two buffered Dyn targets sharing one
       LD, each with its own pre-existing leftover dataset on the server, in
       an order that would cause them to be cross-adopted by EACH OTHER
       without that preference. sim_server.c's own hardcoded model already
       declares a matching brcbDyn2 RCB (inert for every other fixture, which
       doesn't declare it client-side) - see that file's own comment. -->

  <Communication>
    <SubNetwork name="StationBus" type="8-MMS">
      <ConnectedAP iedName="Reporter1" apName="AP1">
        <GSE ldInst="LD1" cbName="gcbInd">
          <Address>
            <P type="VLAN-ID">10</P>
            <P type="VLAN-PRIORITY">4</P>
            <P type="MAC-Address">01-0c-cd-01-00-01</P>
            <P type="APPID">1000</P>
          </Address>
          <MinTime>10</MinTime>
          <MaxTime>5000</MaxTime>
        </GSE>
      </ConnectedAP>
    </SubNetwork>
  </Communication>

  <IED name="Reporter1">
    <AccessPoint name="AP1">
      <Server>
        <LDevice inst="LD1">
          <LN0 lnClass="LLN0" lnType="LLN0Type" inst="">
            <DataSet name="ds1" desc="Indication dataset">
              <FCDA ldInst="LD1" lnClass="GGIO" lnInst="1" fc="ST" doName="Ind1" daName="stVal" />
              <FCDA ldInst="LD1" lnClass="GGIO" lnInst="1" fc="ST" doName="Ind1" daName="q" />
            </DataSet>
            <ReportControl name="brcbMain" rptID="brcbMain" datSet="ds1" confRev="1" buffered="true"
                intgPd="60000" bufTime="0">
              <TrgOps dchg="true" qchg="true" gi="true" />
              <OptFields seqNum="true" timeStamp="true" dataSet="true" reasonCode="true" entryID="true" />
              <RptEnabled max="1" />
            </ReportControl>
            <GSEControl name="gcbInd" appID="1000" datSet="ds1" type="GOOSE" confRev="1" />
          </LN0>
          <LN lnClass="GGIO" lnType="GGIOType" inst="1" prefix="">
            <!-- Deliberately no urcbDyn here (unlike reporter1.cid) - being
                 unbuffered, it has no own-name preference protection at all
                 (adoptUnclaimedDataset's preferred-own-name pass is buffered-
                 only) and, being processed before brcbDyn/brcbDyn2, would
                 otherwise race ahead and steal one of their own leftover
                 datasets via the plain general scan before either one's own
                 preference pass ever runs - an unrelated confound this
                 fixture avoids by construction, not something this test
                 targets.

                 brcbDyn2 is declared (and therefore processed) BEFORE
                 brcbDyn here, deliberately the REVERSE of their alphabetical
                 dataset-name order ("...$BR$brcbDyn$dyn" sorts before
                 "...$BR$brcbDyn2$dyn" - '$' < '2') - so a plain,
                 unpreferenced general scan would have brcbDyn2 (processed
                 first) encounter brcbDyn's own name first and wrongly adopt
                 it, exactly the cross-adoption this test targets. -->
            <ReportControl name="brcbDyn2" rptID="brcbDyn2" confRev="1" buffered="true"
                intgPd="0" bufTime="0">
              <TrgOps dchg="true" qchg="true" gi="true" />
              <OptFields seqNum="true" dataSet="true" reasonCode="true" entryID="true" />
              <RptEnabled max="1" />
            </ReportControl>
            <ReportControl name="brcbDyn" rptID="brcbDyn" confRev="1" buffered="true"
                intgPd="0" bufTime="0">
              <TrgOps dchg="true" qchg="true" gi="true" />
              <OptFields seqNum="true" dataSet="true" reasonCode="true" entryID="true" />
              <RptEnabled max="1" />
            </ReportControl>
          </LN>
        </LDevice>
      </Server>
    </AccessPoint>
  </IED>

  <DataTypeTemplates>
    <LNodeType id="LLN0Type" lnClass="LLN0">
      <DO name="Mod" type="INC1" />
      <DO name="Beh" type="ENS1" />
      <DO name="Health" type="ENS1" />
      <DO name="NamPlt" type="LPL1" />
    </LNodeType>

    <LNodeType id="GGIOType" lnClass="GGIO">
      <DO name="Ind1" type="SPS1" />
      <DO name="SPCSO1" type="SPC1" />
    </LNodeType>

    <DOType id="INC1" cdc="INC">
      <DA name="stVal" bType="INT32" fc="ST" />
      <DA name="q" bType="Quality" fc="ST" />
      <DA name="t" bType="Timestamp" fc="ST" />
      <DA name="ctlModel" bType="Enum" type="CtlModels" fc="CF" />
    </DOType>

    <DOType id="ENS1" cdc="ENS">
      <DA name="stVal" bType="Enum" type="HealthKind" fc="ST" />
      <DA name="q" bType="Quality" fc="ST" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>

    <DOType id="LPL1" cdc="LPL">
      <DA name="vendor" bType="VisString255" fc="DC" />
      <DA name="swRev" bType="VisString255" fc="DC" />
    </DOType>

    <DOType id="SPS1" cdc="SPS">
      <DA name="stVal" bType="BOOLEAN" fc="ST" />
      <DA name="q" bType="Quality" fc="ST" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>

    <DOType id="SPC1" cdc="SPC">
      <DA name="stVal" bType="BOOLEAN" fc="ST" />
      <DA name="q" bType="Quality" fc="ST" />
      <DA name="t" bType="Timestamp" fc="ST" />
      <DA name="Oper" bType="Struct" type="OperSPS" fc="CO" />
      <DA name="ctlModel" bType="Enum" type="CtlModels" fc="CF" />
    </DOType>

    <DAType id="OperSPS">
      <BDA name="ctlVal" bType="BOOLEAN" />
    </DAType>

    <EnumType id="CtlModels">
      <EnumVal ord="0">status-only</EnumVal>
      <EnumVal ord="4">sbo-with-enhanced-security</EnumVal>
    </EnumType>

    <EnumType id="HealthKind">
      <EnumVal ord="1">Ok</EnumVal>
      <EnumVal ord="2">Warning</EnumVal>
      <EnumVal ord="3">Alarm</EnumVal>
    </EnumType>
  </DataTypeTemplates>
</SCL>
